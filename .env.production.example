# TodayInfo VPS production environment example
# Copy this file to /opt/filebrowser/today/.env and replace every CHANGE_ME value.
# Never commit the real .env file.

NODE_ENV=production
PORT=3009

# The admin is served at https://todayinfo.co.za/admin through Nginx.
APP_ORIGIN=https://todayinfo.co.za
PUBLIC_SITE_ORIGIN=https://todayinfo.co.za
PUBLIC_API_ORIGIN=https://api.todayinfo.co.za

# Nginx serves /opt/filebrowser/today/frontend directly for speed.
SERVE_FRONTEND=false
FRONTEND_DIR=frontend

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Production should use PostgreSQL/Supabase instead of demo JSON storage.
DATA_STORE=postgres
DEMO_MODE=
DEMO_ADMIN_USERNAME=apo
DEMO_ADMIN_PASSWORD=CHANGE_ME_NOT_USED_IN_POSTGRES_PRODUCTION

# Existing TodayInfo source crawler.
SOURCE_API_BASE=https://todayinfo-zpshgscq.manus.space/api/v1
SOURCE_DEFAULT_COUNTRY=ZA

AUTO_PUBLISH_IMPORTS=true
AUTO_PUBLISH_MIN_SCORE=80
AUTO_PUBLISH_MAX_PER_FETCH=500

# Primary Supabase/PostgreSQL database.
#
# IPv4-only VPS IMPORTANT:
# Supabase direct db.<project>.supabase.co hosts normally use IPv6.
# Open Supabase Dashboard -> Connect -> Session pooler and copy that URL here.
# TodayInfo prefers DATABASE_URL_IPV4 when it is set.
DATABASE_URL_IPV4=
# Optional direct/secondary database URL. Leave blank on an IPv4-only VPS
# unless the Supabase project has the IPv4 add-on.
DATABASE_URL=
# Optional additional read databases.
DATABASE_URLS=
DATABASE_URL_2=
DATABASE_URL_3=
DATABASE_SSL=true
DATABASE_CONNECT_TIMEOUT_MS=8000

# Optional Supabase Storage. Leave blank when R2 is your file store.
SUPABASE_URL1=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=todayinfo

# Existing R2 publishing/storage bucket. Keep your current bucket and credentials.
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=todayinfo
R2_PUBLIC_BASE_URL=CHANGE_ME_IF_YOU_HAVE_A_PUBLIC_R2_DOMAIN

# Optional invitation email support.
RESEND_API_KEY=
RESEND_FROM=TodayInfo <noreply@todayinfo.co.za>

# Private ingestion API secret.
TODAYINFO_INGEST_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Use these when creating or rotating Apo's CEO/Owner login.
SEED_ADMIN_USERNAME=apo
SEED_ADMIN_PASSWORD=CHANGE_ME_TO_YOUR_NEW_OWNER_PASSWORD
SEED_ADMIN_EMAIL=CHANGE_ME
