# TodayInfo VPS production environment example
# Copy to .env on the VPS and replace every CHANGE_ME value.
# Never commit the real .env file.

NODE_ENV=production
PORT=3009
APP_ORIGIN=https://api.todayinfo.co.za
PUBLIC_SITE_ORIGIN=https://todayinfo.co.za
PUBLIC_API_ORIGIN=https://api.todayinfo.co.za

# false = Cloudflare Pages frontend (recommended). true = serve frontend/ from this Node VPS.
SERVE_FRONTEND=false
FRONTEND_DIR=frontend
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

DATA_STORE=postgres
DEMO_MODE=
DEMO_ADMIN_USERNAME=apo
DEMO_ADMIN_PASSWORD=CHANGE_ME_NOT_USED_IN_POSTGRES_PRODUCTION

SOURCE_API_BASE=https://todayinfo-zpshgscq.manus.space/api/v1
SOURCE_DEFAULT_COUNTRY=ZA

AUTO_PUBLISH_IMPORTS=true
AUTO_PUBLISH_MIN_SCORE=80
AUTO_PUBLISH_MAX_PER_FETCH=500

# Primary Supabase/PostgreSQL database.
DATABASE_URL=CHANGE_ME
DATABASE_URLS=
DATABASE_URL_2=
DATABASE_URL_3=
DATABASE_SSL=true

# Optional Supabase Storage. Leave blank if R2 is your file store.
SUPABASE_URL1=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=todayinfo

# Existing Cloudflare R2 bucket — bucket name intentionally unchanged.
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=todayinfo
R2_PUBLIC_BASE_URL=CHANGE_ME_IF_YOU_HAVE_A_PUBLIC_R2_DOMAIN

RESEND_API_KEY=
RESEND_FROM=TodayInfo <noreply@todayinfo.co.za>

TODAYINFO_INGEST_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Use these only when creating/resetting Apo's owner account.
SEED_ADMIN_USERNAME=apo
SEED_ADMIN_PASSWORD=CHANGE_ME_TO_YOUR_NEW_OWNER_PASSWORD
SEED_ADMIN_EMAIL=CHANGE_ME
