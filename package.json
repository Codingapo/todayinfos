{
  "name": "todayinfo-control-center",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "find src scripts tests -name '*.mjs' -print0 | xargs -0 -n1 node --check && node --check public/admin/app.js",
    "seed:admin": "node scripts/seed-admin.mjs",
    "doctor": "node scripts/config-doctor.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "zod": "^4.1.11",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.2.5"
  }
}
