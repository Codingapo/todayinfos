[Unit]
Description=TodayInfo API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/today
EnvironmentFile=/var/www/today/.env
ExecStart=/usr/bin/node /var/www/today/src/server.mjs
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

# Basic hardening while allowing local fallback/uploads.
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
