NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:8787
JWT_SECRET=replace-with-a-long-random-secret

# Preferred storage selection:
# auto     = use PostgreSQL when DATABASE_URL is valid, otherwise demo storage
# demo     = always use demo JSON storage
# postgres = require PostgreSQL and fail fast if DATABASE_URL is invalid
DATA_STORE=auto

# Backwards compatibility only. Leave blank for DATA_STORE to decide.
# true forces demo mode; false no longer forces PostgreSQL.
DEMO_MODE=
DEMO_ADMIN_USERNAME=apo
DEMO_ADMIN_PASSWORD=admin

# Existing TodayInfo crawler API. Imports only; never exposed directly to public users.
SOURCE_API_BASE=https://todayinfo-zpshgscq.manus.space/api/v1

# Supabase/PostgreSQL. Paste the REAL connection string here when ready.
# Do not use placeholder hosts such as "host".
DATABASE_URL=
DATABASE_SSL=true

# Supabase Storage. IMPORTANT: works in DEMO/TESTING mode too.
# If set, uploads use Supabase Storage even when the data store is demo.
SUPABASE_URL1=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=todayinfo

# Cloudflare R2. Used when Supabase Storage is not configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=todayinfo
R2_PUBLIC_BASE_URL=

# Resend for worker/admin invitations
RESEND_API_KEY=
RESEND_FROM=TodayInfo <noreply@example.com>
