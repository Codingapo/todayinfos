NODE_ENV=development
PORT=3009
APP_ORIGIN=https://todayinfo.co.za
JWT_SECRET=replace-with-a-long-random-secret

# Public website / API deployment.
# Recommended: Cloudflare Pages serves todayinfo.co.za and the VPS serves api.todayinfo.co.za:443 -> localhost:3009.
PUBLIC_API_BASE_URL=https://api.todayinfo.co.za/api/v1
SERVE_FRONTEND=false
FRONTEND_DIR=frontend
CORS_ORIGINS=https://todayinfo.co.za,https://www.todayinfo.co.za
PUBLIC_CACHE_SECONDS=60
PUBLIC_EDGE_CACHE_SECONDS=300

# Preferred storage selection:
# auto     = use PostgreSQL when DATABASE_URL is valid, otherwise demo storage
# demo     = always use demo JSON storage
# postgres = require PostgreSQL and fail fast if DATABASE_URL is invalid
DATA_STORE=auto

# Backwards compatibility only. Leave blank for DATA_STORE to decide.
# true forces demo mode; false no longer forces PostgreSQL.
DEMO_MODE=
DEMO_ADMIN_USERNAME=apo
DEMO_ADMIN_PASSWORD=admin

# Existing TodayInfo crawler API. Imports only; never exposed directly to public users.
SOURCE_API_BASE=https://todayinfo-zpshgscq.manus.space/api/v1
SOURCE_DEFAULT_COUNTRY=ZA

# Import automation. 80 means every fetched item scoring 80% or more may publish
# only if all hard safety/publishing checks also pass.
AUTO_PUBLISH_IMPORTS=true
AUTO_PUBLISH_MIN_SCORE=80
AUTO_PUBLISH_MAX_PER_FETCH=500

# Supabase/PostgreSQL. Paste the REAL connection string here when ready.
# Do not use placeholder hosts such as "host".
DATABASE_URL=
# Optional additional read databases. Use a comma-separated list or DATABASE_URL_2, DATABASE_URL_3, etc.
DATABASE_URLS=
DATABASE_URL_2=
DATABASE_URL_3=
DATABASE_SSL=true

# Supabase Storage. IMPORTANT: works in DEMO/TESTING mode too.
# If set, uploads use Supabase Storage even when the data store is demo.
SUPABASE_URL1=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=todayinfo

# Cloudflare R2. Used when Supabase Storage is not configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=todayinfo
R2_PUBLIC_BASE_URL=

# Resend for worker/admin invitations
RESEND_API_KEY=
RESEND_FROM=TodayInfo <noreply@example.com>

# Private ingestion API secret. Use a long random value in Render; never expose it in frontend code.
TODAYINFO_INGEST_KEY=
